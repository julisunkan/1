# Copy this file to .env and fill in your values.
# On PythonAnywhere, set these in the Web tab → Environment variables section
# (or export them in your virtualenv postactivate script).

# Required: a long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override the wkhtmltopdf binary location if auto-detection fails.
# PythonAnywhere free tier: /usr/bin/wkhtmltopdf
# Leave blank to let the app detect it automatically.
WKHTMLTOPDF_PATH=
